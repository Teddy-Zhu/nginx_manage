{
  "schema": 1,
  "id": "example",
  "name": "示例软件源",
  "applications": [
    {
      "id": "web",
      "name": "演示网站",
      "description": "演示统一的软件状态、操作、日志和网页入口。",
      "actions": {
        "install": {
          "command": [
            "/bin/sh",
            "-c",
            "curl -fsSL BUNDLE_URL -o demo.tar.gz && printf \"%s\\n\" BUNDLE_CHECKSUM | sha256sum -c - && mkdir -p .package && tar -xzf demo.tar.gz -C .package && /bin/sh .package/install.sh"
          ],
          "description": "下载演示软件包并安装网站"
        },
        "start": {
          "command": [
            "/bin/sh",
            "./manage.sh",
            "start"
          ],
          "description": "启动演示网站"
        },
        "stop": {
          "command": [
            "/bin/sh",
            "./manage.sh",
            "stop"
          ],
          "description": "停止演示网站"
        },
        "restart": {
          "command": [
            "/bin/sh",
            "./manage.sh",
            "restart"
          ],
          "description": "重启演示网站"
        },
        "update": {
          "command": [
            "/bin/sh",
            "./manage.sh",
            "update"
          ],
          "description": "更新演示网站，保留网站数据"
        },
        "uninstall": {
          "command": [
            "/bin/sh",
            "./manage.sh",
            "uninstall"
          ],
          "description": "停止并卸载演示网站，保留网站数据"
        },
        "logs": {
          "command": [
            "/bin/sh",
            "./manage.sh",
            "logs"
          ],
          "description": "查看最近的服务日志"
        },
        "status": {
          "command": [
            "/bin/sh",
            "./manage.sh",
            "status"
          ],
          "description": "检查网站状态并返回访问入口"
        },
        "check-version": {
          "command": [
            "/bin/sh",
            "-c",
            "if [ -f ./manage.sh ]; then /bin/sh ./manage.sh check-version; else case \"$NGINXPANEL_TARGET_VERSION\" in 1.0.0|1.1.0) command -v docker >/dev/null;; *) exit 1;; esac; fi"
          ],
          "description": "检查所选版本及运行条件"
        },
        "backup": {
          "command": [
            "/bin/sh",
            "./manage.sh",
            "backup"
          ],
          "description": "备份版本管理的页面"
        },
        "restore": {
          "command": [
            "/bin/sh",
            "./manage.sh",
            "restore"
          ],
          "description": "恢复原版本"
        }
      },
      "versions": [
        {
          "id": "1.1.0",
          "version": "1.1.0",
          "channel": "stable",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "notes": "演示新版页面，支持恢复到 1.0.0。"
        },
        {
          "id": "1.0.0",
          "version": "1.0.0",
          "channel": "stable",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "notes": "基础演示版本。"
        }
      ]
    }
  ]
}
