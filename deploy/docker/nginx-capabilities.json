{
  "schema": 1,
  "nginx_version": "1.30.6",
  "module_policy": "image-only",
  "static_features": [
    "http", "tls", "real_ip", "stream", "stream_tls", "stream_real_ip",
    "stream_ssl_preread", "map", "map_volatile", "rewrite", "http01",
    "limit_req", "limit_conn", "limit_req_status", "limit_conn_status",
    "limit_req_observe", "limit_conn_observe", "https_redirect", "hsts",
    "http_proxy", "http_access", "http_log", "http_headers", "http_geo",
    "http_split_clients", "http_charset", "http_gzip", "stream_map",
    "stream_map_volatile", "stream_access", "stream_log", "stream_geo",
    "stream_split_clients", "stream_limit_conn", "stream_limit_conn_observe",
    "stream_return", "stream_set"
