{
  "name": "nginxpanel-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc6 --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write src vite.config.ts",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "generate:routes": "node scripts/generate-routes.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@vue/devtools-api": "8.2.1",
    "axios": "1.20.0",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
